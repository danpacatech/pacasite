---
layout: base.njk
---
{% if date_start %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TheaterEvent",
  "name": {{ title | dump | safe }},
  "startDate": {{ date_start | schemaDate | dump | safe }},
  "endDate": {{ (date_end or date_start) | schemaDate | dump | safe }},
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  {% if summary %}"description": {{ summary | dump | safe }},{% endif %}
  {% if image %}"image": [{{ (image | absUrl(site.url)) | dump | safe }}],{% endif %}
  "location": {
    "@type": "Place",
    "name": "PACA (Performing Artists Collective Alliance)",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1505 State Street",
      "addressLocality": "Erie",
      "addressRegion": "PA",
      "postalCode": "16501",
      "addressCountry": "US"
    }
  },
  "organizer": { "@type": "Organization", "name": "PACA", "url": {{ site.url | dump | safe }} },
  "performer": { "@type": "PerformingGroup", "name": "PACA" }{% if ticket_url or site.tickets %},
  "offers": {
    "@type": "Offer",
    "url": {{ (ticket_url or site.tickets) | dump | safe }},
    "availability": "https://schema.org/InStock"
  }{% endif %}
}
</script>
{% endif %}
<section class="show-detail">
  <div class="wrap">
    <a class="back" href="/whats-on/">← Back to What's On</a>
    <div class="meta">
      <span class="disc-tag" style="background:{{ discipline | disccolor }}">{{ discipline }}</span>
      <span class="label">{{ date_label or (date_start | dateDisp) }}{% if showtime %} · {{ showtime }}{% endif %}</span>
    </div>
    <h1>{{ title }}</h1>
    {% if image %}<img class="poster" src="{{ image }}" alt="{{ title }}">{% endif %}
    {% if runtime or price or content_warning %}
    <ul class="show-facts">
      {% if runtime %}<li><span>Run time</span>{{ runtime }}</li>{% endif %}
      {% if price %}<li><span>Tickets</span>{{ price }}</li>{% endif %}
      {% if content_warning %}<li><span>Content note</span>{{ content_warning }}</li>{% endif %}
    </ul>
    {% endif %}
    <div class="prose">
      {% if summary %}<p style="font-size:1.25rem;color:var(--cream)">{{ summary }}</p>{% endif %}
      {% if recap %}{{ recap | markdownify | safe }}{% endif %}
      {{ content | safe }}
    </div>
    {% if credits %}
    <div class="show-credits">
      <h3>Cast &amp; creative</h3>
      <div class="credits-body">{{ credits }}</div>
    </div>
    {% endif %}
    {% if gallery and gallery.length %}
    <div class="show-gallery">
      {% for src in gallery %}
      <img src="{{ src }}" alt="{{ title }} production photo" loading="lazy">
      {% endfor %}
    </div>
    {% endif %}
    <div class="cta">
      <a class="btn btn-primary" href="{{ ticket_url or site.tickets }}" target="_blank" rel="noopener">Get Tickets</a>
      <a class="btn btn-ghost" href="/whats-on/">More Shows</a>
      {% if playbill %}<a class="btn btn-ghost" href="{{ playbill }}" target="_blank" rel="noopener">Playbill (PDF)</a>{% endif %}
      {% if bios_url %}<a class="btn btn-ghost" href="{{ bios_url }}">Meet the Cast</a>{% elif bios_live %}<a class="btn btn-ghost" href="/bios/">Meet the Cast</a>{% endif %}
    </div>
    {% if date_start %}
    <div class="addcal">
      <span>Add to calendar</span>
      <a href="{{ date_start | gcalHref(date_end, title, summary, site.address) }}" target="_blank" rel="noopener">Google</a>
      <a href="{{ date_start | icsHref(date_end, title, summary, site.address) }}" download="paca-event.ics">Apple / Outlook</a>
    </div>
    {% endif %}
  </div>
</section>
