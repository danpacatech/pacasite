<!DOCTYPE html>
<html lang="en" data-theme="{{ site.theme or 'default' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.name }} - {% if title %}{{ title }}{% else %}{{ site.fullName }}{% endif %}</title>
{% set desc = description or summary or 'A black-box theatre and arts collective in downtown Erie. Theatre, music, visual art, prose and dance at 1505 State Street.' %}
{% set shareImg = (image or logo or "/assets/og-image.png") | absUrl(site.url) %}
<meta name="description" content="{{ desc }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{% if title %}{{ title }} - {{ site.name }}{% else %}{{ site.fullName }}{% endif %}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ page.url | absUrl(site.url) }}">
<meta property="og:image" content="{{ shareImg }}">
<meta property="og:image:alt" content="{% if title %}{{ title }} - {{ site.name }}{% else %}{{ site.name }}{% endif %}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title }} - {{ site.name }}{% else %}{{ site.fullName }}{% endif %}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="{{ shareImg }}">
<link rel="icon" type="image/png" href="/assets/paca-circle.png">
<link rel="apple-touch-icon" href="/assets/paca-circle.png">
<meta name="theme-color" content="#2B0B3E">
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<link rel="canonical" href="{{ page.url | absUrl(site.url) }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ site.fullName | dump | safe }},
  "alternateName": "PACA",
  "url": {{ site.url | dump | safe }},
  "logo": {{ ("/assets/paca-circle.png" | absUrl(site.url)) | dump | safe }},
  "email": "paca1505@gmail.com",
  "telephone": {{ site.phone | dump | safe }},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1505 State Street",
    "addressLocality": "Erie",
    "addressRegion": "PA",
    "postalCode": "16501",
    "addressCountry": "US"
  },
  "sameAs": [
    {{ (site.instagram if (site.instagram and site.instagram != '#') else 'https://www.instagram.com/paca1505/') | dump | safe }},
    {{ (site.facebook if (site.facebook and site.facebook != '#') else 'https://www.facebook.com/paca1505/') | dump | safe }}{% if site.youtube and site.youtube != '#' %},
    {{ site.youtube | dump | safe }}{% endif %}{% if site.tiktok and site.tiktok != '#' %},
    {{ site.tiktok | dump | safe }}{% endif %}
  ]
}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,400..700&family=Hanken+Grotesk:wght@300;400;500;600;700;800&family=Spline+Sans+Mono:wght@400;500;600&display=swap" rel="stylesheet">
{% if paymentspring %}<link rel="stylesheet" type="text/css" href="https://checkout.paymentspring.com/assets/application.css">{% endif %}
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
<div class="grain"></div>
<div class="spot" id="spot"></div>

{% if not kiosk %}
<header>
  <div class="wrap">
    <nav>
      <a class="brand" href="/"><img class="seal-img" src="/assets/paca-circle.png" alt="PACA">PACA</a>
      <div class="navlinks" id="nav">
        {% set navitems = [
          { label: "What's On", url: "/whats-on/", match: ["/whats-on/", "/shows/", "/disciplines/"] },
          { label: "Who We Are", url: "/who-we-are/", match: ["/who-we-are/"] },
          { label: "Get Involved", url: "/get-involved/", match: ["/get-involved/", "/volunteer/", "/auditions/"] },
          { label: "Visit", url: "/visit/", match: ["/visit/"] },
          { label: "What's Here", url: "/whats-here/", match: ["/whats-here/"] },
          { label: "Rentals", url: "/rent-our-spaces/", match: ["/rent-our-spaces/"] }
        ] %}
        {% for n in navitems %}<a href="{{ n.url }}"{% if page.url | isActive(n.match) %} class="active" aria-current="page"{% endif %}>{{ n.label }}</a>
        {% endfor %}
        <a class="btn btn-ghost" href="{{ site.merch or 'mailto:paca1505@gmail.com?subject=Merch' }}"{% if site.merch %} target="_blank" rel="noopener"{% endif %}>Merch</a>
        <a class="btn btn-primary" href="{{ site.tickets }}" target="_blank" rel="noopener">Tickets</a>
      </div>
      <button class="menu-btn" id="menuBtn" aria-label="Menu">≡</button>
    </nav>
  </div>
</header>
{% endif %}

<main id="main">
{{ content | safe }}
</main>

{% if not kiosk %}
<footer>
  <div class="wrap">
    <div class="fgrid">
      <div class="fbrand">
        <a class="brand" href="/"><img class="seal-img" src="/assets/paca-circle.png" alt="PACA">PACA</a>
        <p>{{ site.fullName }}. A black-box theatre and arts collective in downtown Erie, Pennsylvania.</p>
      </div>
      <div class="fcol">
        <h5>Explore</h5>
        <a href="/who-we-are/">Who We Are</a>
        <a href="/get-involved/">Get Involved</a>
        <a href="/visit/">Visit</a>
        <a href="/whats-here/">What's Here</a>
      </div>
      <div class="fcol">
        <h5>Connect</h5>
        <a href="{{ site.tickets }}" target="_blank" rel="noopener">Tickets</a>
        <a href="/donate/">Donate</a>
        <a href="{{ site.instagram if (site.instagram and site.instagram != '#') else 'https://www.instagram.com/paca1505/' }}" target="_blank" rel="noopener">Instagram</a>
        <a href="{{ site.facebook if (site.facebook and site.facebook != '#') else 'https://www.facebook.com/paca1505/' }}" target="_blank" rel="noopener">Facebook</a>
        {% if site.youtube and site.youtube != '#' %}<a href="{{ site.youtube }}" target="_blank" rel="noopener">YouTube</a>{% endif %}
        {% if site.tiktok and site.tiktok != '#' %}<a href="{{ site.tiktok }}" target="_blank" rel="noopener">TikTok</a>{% endif %}
      </div>
    </div>
    <div class="fbot">
      <span>© {{ "" | year }} {{ site.fullName }}</span>
      <span>{{ site.address }} · {{ site.phone }}</span>
    </div>
  </div>
</footer>
{% endif %}

{% if collections.sponsors and collections.sponsors.length and not kiosk %}
<div class="sponsors">
  <span class="sponsors-label">Special thanks to</span>
  <div class="sponsors-viewport">
    <div class="sponsors-track">
      {% for s in collections.sponsors %}<span class="sponsor">{% if s.data.url %}<a href="{{ s.data.url }}" target="_blank" rel="noopener">{% endif %}<img src="{{ s.data.logo }}" alt="{{ s.data.name }}">{% if s.data.url %}</a>{% endif %}</span>{% endfor %}
      {% for s in collections.sponsors %}<span class="sponsor" aria-hidden="true">{% if s.data.url %}<a href="{{ s.data.url }}" target="_blank" rel="noopener">{% endif %}<img src="{{ s.data.logo }}" alt="">{% if s.data.url %}</a>{% endif %}</span>{% endfor %}
    </div>
  </div>
</div>
{% endif %}

<script>
const spot=document.getElementById('spot');
addEventListener('mousemove',e=>{spot.style.setProperty('--mx',e.clientX+'px');spot.style.setProperty('--my',e.clientY+'px');});
const nav=document.getElementById('nav'),mb=document.getElementById('menuBtn');
if(mb){mb.addEventListener('click',()=>nav.classList.toggle('open'));nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>nav.classList.remove('open')));}
const io=new IntersectionObserver((es)=>es.forEach((en,i)=>{if(en.isIntersecting){en.target.style.transitionDelay=(i%6*60)+'ms';en.target.classList.add('in');io.unobserve(en.target);}}),{threshold:.12});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// Random hero logo personality, fresh on every visit
(function(){
  var wrap=document.querySelector('.hero-mark'); if(!wrap) return;
  var logo=wrap.querySelector('img')||wrap;
  if(matchMedia('(prefers-reduced-motion: reduce)').matches){logo.style.animation='none';return;}
  var M=[{n:'float',b:6,t:'ease-in-out'},{n:'bouncy',b:1.8,t:'cubic-bezier(.34,1.4,.5,1)'},{n:'throb',b:2.4,t:'ease-in-out'},{n:'wobble',b:3,t:'ease-in-out'},{n:'spin',b:13,t:'linear'},{n:'follow'}];
  var C=[null,{n:'rainbow',b:8,t:'linear'},{n:'glow',b:3.2,t:'ease-in-out'},{n:'neon',b:1.4,t:'ease-in-out'}];
  var p=function(a){return a[Math.floor(Math.random()*a.length)];};
  var m=p(M),c=p(C),s=0.8+Math.random()*0.7,an=[];
  if(m.n!=='follow')an.push(m.n+' '+(m.b/s).toFixed(2)+'s '+m.t+' infinite');
  if(c)an.push(c.n+' '+(c.b/s).toFixed(2)+'s '+c.t+' infinite');
  logo.style.animation=an.length?an.join(', '):'none';
  if(m.n==='follow'){
    var hero=wrap.closest('.hero')||document.body; logo.style.transition='transform .25s ease';
    hero.addEventListener('mousemove',function(e){var r=hero.getBoundingClientRect();var dx=(e.clientX-(r.left+r.width/2))/r.width*60;var dy=(e.clientY-(r.top+r.height/2))/r.height*40;logo.style.transform='translate('+dx+'px,'+dy+'px) rotate('+(dx/16)+'deg)';});
  }
})();
</script>
</body>
</html>
