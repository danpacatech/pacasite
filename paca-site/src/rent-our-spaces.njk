---
layout: base.njk
title: Rent Our Spaces
description: Rent studio and creative space at PACA, 1505 State Street in downtown Erie, PA.
---
{% set doc = collections.rentdoc | first %}

<section class="page-head">
  <div class="wrap">
    <div class="eyebrow label">What we do</div>
    <h1>Rent our <em>spaces</em></h1>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="prose rv" style="max-width:780px">
      {% if doc %}{{ doc.templateContent | safe }}{% else %}<p style="color:var(--fog)">Rental information is coming soon. Add it in the CMS under Rent Our Spaces.</p>{% endif %}
    </div>
  </div>
</section>

<section class="block" style="border-bottom:none">
  <div class="wrap">
    <div class="sec-head rv"><span class="num">→</span><h2>Request a space</h2></div>
    <form name="rental-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="rform rv">
      <input type="hidden" name="form-name" value="rental-inquiry">
      <p hidden><label>Leave this empty: <input name="bot-field"></label></p>
      <div><label>First name *</label><input type="text" name="first_name" required></div>
      <div><label>Last name *</label><input type="text" name="last_name" required></div>
      <div><label>Email *</label><input type="email" name="email" required></div>
      <div><label>Phone</label><input type="tel" name="phone"></div>
      <div class="full"><label>Business or organization name</label><input type="text" name="organization"></div>
      <div class="full"><label>What would you like to use the space for?</label><textarea name="use"></textarea></div>
      <div class="full"><label>Additional comments</label><textarea name="comments"></textarea></div>
      <div class="full"><button class="btn btn-primary" type="submit">Send request</button></div>
    </form>
  </div>
</section>
