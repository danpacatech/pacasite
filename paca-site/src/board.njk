---
permalink: /board/
eleventyExcludeFromCollections: true
---
{% raw %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>PACA Board Terminal</title>
<style>
  :root{--fg:#33ff66;--dim:#1f8a3f;--amber:#ffb000;--warn:#ff5a5a}
  *{box-sizing:border-box}
  html,body{margin:0;background:#000;color:var(--fg);font-family:'Courier New',ui-monospace,monospace}
  body{min-height:100vh;background:radial-gradient(120% 100% at 50% 0%,#0c160c,#000);padding:20px;font-size:15px;line-height:1.5}
  .crt{max-width:840px;margin:0 auto;border:1px solid var(--dim);border-radius:6px;padding:20px;background:rgba(8,16,8,.55);box-shadow:0 0 40px rgba(51,255,102,.08),inset 0 0 60px rgba(51,255,102,.03);position:relative;overflow:hidden}
  .crt::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,0) 0 2px,rgba(0,0,0,.22) 2px 3px)}
  .banner{color:var(--fg);text-shadow:0 0 6px rgba(51,255,102,.55);font-size:12px;line-height:1.05;margin:0 0 8px;white-space:pre;overflow-x:auto}
  .sub{color:var(--dim);margin:0 0 18px;font-size:12px;letter-spacing:.06em}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  input,textarea,button{font-family:inherit;font-size:14px;background:#020602;color:var(--fg);border:1px solid var(--dim);border-radius:4px;padding:9px 11px}
  input:focus,textarea:focus{outline:none;border-color:var(--fg);box-shadow:0 0 8px rgba(51,255,102,.3)}
  button{cursor:pointer;text-transform:uppercase;letter-spacing:.08em}
  button:hover{background:var(--fg);color:#021002}
  textarea{width:100%;min-height:84px;resize:vertical}
  .blink{animation:bl 1s steps(2) infinite}@keyframes bl{50%{opacity:0}}
  .hidden{display:none}
  .err{color:var(--warn)}
  hr{border:none;border-top:1px dashed var(--dim);margin:18px 0}
  h2.sec{color:var(--amber);text-shadow:0 0 6px rgba(255,176,0,.45);font-size:14px;letter-spacing:.12em;margin:0 0 12px}
  .post{border-left:2px solid var(--dim);padding:4px 0 6px 12px;margin:0 0 12px}
  .post .meta{color:var(--amber);font-size:12px}
  .post .body{white-space:pre-wrap;word-break:break-word}
  .muted{color:var(--dim);font-size:12px}
  a{color:var(--amber)}
  iframe{width:100%;height:440px;border:1px solid var(--dim);border-radius:4px;background:#fff}
</style>
</head>
<body>
<div class="crt">
  <pre class="banner">██████╗  █████╗  ██████╗ █████╗
██╔══██╗██╔══██╗██╔════╝██╔══██╗
██████╔╝███████║██║     ███████║
██╔═══╝ ██╔══██║██║     ██╔══██║
██║     ██║  ██║╚██████╗██║  ██║
╚═╝     ╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝</pre>
  <p class="sub">PERFORMING ARTISTS COLLECTIVE ALLIANCE // BOARD &amp; STAFF TERMINAL</p>

  <div id="login">
    <p>RESTRICTED SYSTEM. AUTHORIZED PERSONNEL ONLY.</p>
    <div class="row">
      <span>ACCESS CODE:</span>
      <input id="code" type="password" autocomplete="off" autofocus>
      <button id="enter">ENTER</button>
      <span class="blink">&#9608;</span>
    </div>
    <p id="loginErr" class="err hidden">ACCESS DENIED. TRY AGAIN.</p>
  </div>

  <div id="board" class="hidden">
    <div class="row" style="justify-content:space-between">
      <span class="muted">CONNECTED // WELCOME, BOARD MEMBER</span>
      <button id="logout">LOG OFF</button>
    </div>
    <hr>
    <h2 class="sec">// CALENDAR</h2>
    <div id="calWrap"></div>
    <hr>
    <h2 class="sec">// MESSAGE BOARD</h2>
    <div style="display:flex;flex-direction:column;gap:8px">
      <input id="handle" placeholder="YOUR NAME / HANDLE" maxlength="40">
      <textarea id="msg" placeholder="Type your message, then POST..." maxlength="2000"></textarea>
      <div class="row" style="justify-content:flex-end"><button id="post">POST MESSAGE</button></div>
      <p id="postErr" class="err hidden"></p>
    </div>
    <hr>
    <div id="posts"></div>
  </div>
</div>

<script>
  // ===== EDIT ME: paste your board Google Calendar embed URL =====
  // (Google Calendar > Settings > your calendar > Integrate calendar > copy the src="..." from the Embed code)
  var CONFIG = {
    calEmbed: "https://calendar.google.com/calendar/embed?src=89b14aa8a9197cacb2eaacbfc9a3e781af2979e8af95598d63e8a0efe4c7a0bb%40group.calendar.google.com&ctz=America%2FNew_York",
    calLink:  "https://calendar.google.com/calendar/embed?src=89b14aa8a9197cacb2eaacbfc9a3e781af2979e8af95598d63e8a0efe4c7a0bb%40group.calendar.google.com&ctz=America%2FNew_York"
  };

  var API = "/.netlify/functions/board";
  var $ = function(id){ return document.getElementById(id); };
  var KEY = sessionStorage.getItem("boardKey") || "";

  function show(el){ el.classList.remove("hidden"); }
  function hide(el){ el.classList.add("hidden"); }

  function api(method, body){
    return fetch(API, {
      method: method,
      headers: { "x-board-key": KEY, "content-type": "application/json" },
      body: body ? JSON.stringify(body) : undefined
    });
  }

  function fmt(ts){ try { return new Date(ts).toLocaleString(); } catch(e){ return ts; } }

  function renderPosts(posts){
    var wrap = $("posts"); wrap.textContent = "";
    if(!posts || !posts.length){
      var p = document.createElement("p"); p.className = "muted";
      p.textContent = "No messages yet. Be the first to post."; wrap.appendChild(p); return;
    }
    posts.slice().reverse().forEach(function(po){
      var d = document.createElement("div"); d.className = "post";
      var m = document.createElement("div"); m.className = "meta";
      m.textContent = ">> " + po.name + "  [" + fmt(po.ts) + "]";
      var b = document.createElement("div"); b.className = "body"; b.textContent = po.message;
      d.appendChild(m); d.appendChild(b); wrap.appendChild(d);
    });
  }

  function renderCal(){
    var w = $("calWrap"); w.textContent = "";
    if(CONFIG.calEmbed){
      var f = document.createElement("iframe");
      f.src = CONFIG.calEmbed; f.title = "Board Calendar"; f.loading = "lazy"; w.appendChild(f);
    } else {
      var p = document.createElement("p"); p.className = "muted";
      p.textContent = "No calendar set yet. Paste your Google Calendar embed URL into CONFIG.calEmbed in board.njk.";
      w.appendChild(p);
    }
    if(CONFIG.calLink){
      var a = document.createElement("a");
      a.href = CONFIG.calLink; a.target = "_blank"; a.rel = "noopener";
      a.textContent = "Open full calendar \u2192"; a.style.display = "inline-block"; a.style.marginTop = "8px";
      w.appendChild(a);
    }
  }

  function unlock(code){
    if(!code) return;
    KEY = code;
    api("GET").then(function(res){
      if(res.status === 200){
        return res.json().then(function(data){
          sessionStorage.setItem("boardKey", KEY);
          hide($("login")); show($("board"));
          $("handle").value = localStorage.getItem("boardHandle") || "";
          renderCal(); renderPosts(data.posts || []);
        });
      } else {
        KEY = ""; sessionStorage.removeItem("boardKey"); show($("loginErr"));
      }
    }).catch(function(){ show($("loginErr")); });
  }

  $("enter").addEventListener("click", function(){ unlock($("code").value.trim()); });
  $("code").addEventListener("keydown", function(e){ if(e.key === "Enter") unlock($("code").value.trim()); });
  $("logout").addEventListener("click", function(){
    KEY = ""; sessionStorage.removeItem("boardKey");
    hide($("board")); show($("login")); $("code").value = ""; hide($("loginErr"));
  });

  $("post").addEventListener("click", function(){
    var name = $("handle").value.trim();
    var message = $("msg").value.trim();
    hide($("postErr"));
    if(!message){ $("postErr").textContent = "Message is empty."; show($("postErr")); return; }
    if(name) localStorage.setItem("boardHandle", name);
    api("POST", { name: name, message: message }).then(function(res){
      if(res.status === 200){
        return res.json().then(function(data){ $("msg").value = ""; renderPosts(data.posts || []); });
      } else if(res.status === 401){
        $("postErr").textContent = "Session expired. Reload and log in again."; show($("postErr"));
      } else {
        return res.json().catch(function(){ return {}; }).then(function(d){
          $("postErr").textContent = "Error: " + (d.error || res.status); show($("postErr"));
        });
      }
    });
  });

  if(KEY){ unlock(KEY); }
</script>
</body>
</html>{% endraw %}
