---
permalink: /board/
eleventyExcludeFromCollections: true
---
{% raw %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>PACA Board Terminal</title>
<style>
  :root{--fg:#33ff66;--dim:#1f8a3f;--amber:#ffb000;--warn:#ff5a5a}
  *{box-sizing:border-box}
  html,body{margin:0;background:#000;color:var(--fg);font-family:'Courier New',ui-monospace,monospace}
  body{min-height:100vh;background:radial-gradient(120% 100% at 50% 0%,#0c160c,#000);padding:20px;font-size:15px;line-height:1.5}
  .crt{max-width:860px;margin:0 auto;border:1px solid var(--dim);border-radius:6px;padding:20px;background:rgba(8,16,8,.55);box-shadow:0 0 40px rgba(51,255,102,.08),inset 0 0 60px rgba(51,255,102,.03);position:relative;overflow:hidden}
  .crt::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,0) 0 2px,rgba(0,0,0,.22) 2px 3px)}
  .banner{color:var(--fg);text-shadow:0 0 6px rgba(51,255,102,.55);font-size:12px;line-height:1.05;margin:0 0 8px;white-space:pre;overflow-x:auto}
  .sub{color:var(--dim);margin:0 0 18px;font-size:12px;letter-spacing:.06em}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  input,textarea,button{font-family:inherit;font-size:14px;background:#020602;color:var(--fg);border:1px solid var(--dim);border-radius:4px;padding:9px 11px}
  input:focus,textarea:focus{outline:none;border-color:var(--fg);box-shadow:0 0 8px rgba(51,255,102,.3)}
  button{cursor:pointer;text-transform:uppercase;letter-spacing:.06em}
  button:hover{background:var(--fg);color:#021002}
  button.ghost{background:transparent}
  textarea{width:100%;min-height:74px;resize:vertical}
  .blink{animation:bl 1s steps(2) infinite}@keyframes bl{50%{opacity:0}}
  .hidden{display:none}
  .err{color:var(--warn)}
  hr{border:none;border-top:1px dashed var(--dim);margin:16px 0}
  h2.sec{color:var(--amber);text-shadow:0 0 6px rgba(255,176,0,.45);font-size:14px;letter-spacing:.12em;margin:0 0 12px}
  .muted{color:var(--dim);font-size:12px}
  a{color:var(--amber);cursor:pointer}
  iframe{width:100%;height:360px;border:1px solid var(--dim);border-radius:4px;background:#fff}
  .crumbs{font-size:12px;color:var(--dim);margin:0 0 14px;letter-spacing:.05em}
  .crumbs a{color:var(--amber)}
  .item{border:1px solid var(--dim);border-radius:4px;padding:11px 13px;margin:0 0 10px;display:flex;justify-content:space-between;align-items:center;gap:10px}
  .item:hover{border-color:var(--fg);box-shadow:0 0 10px rgba(51,255,102,.15)}
  .item .t{color:var(--fg);font-size:15px}
  .item .m{color:var(--dim);font-size:12px;margin-top:2px}
  .item .open{flex:1;cursor:pointer}
  .xbtn{background:transparent;border-color:#5a2a2a;color:var(--warn);padding:4px 9px;font-size:12px}
  .xbtn:hover{background:var(--warn);color:#1a0202}
  .post{border-left:2px solid var(--dim);padding:4px 0 6px 12px;margin:0 0 12px}
  .post .meta{color:var(--amber);font-size:12px}
  .post .body{white-space:pre-wrap;word-break:break-word}
  .newbox{border:1px dashed var(--dim);border-radius:4px;padding:12px;margin:0 0 16px;display:flex;flex-direction:column;gap:8px}
  .toolbar{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:0 0 12px}
</style>
</head>
<body>
<div class="crt">
  <pre class="banner">██████╗  █████╗  ██████╗ █████╗
██╔══██╗██╔══██╗██╔════╝██╔══██╗
██████╔╝███████║██║     ███████║
██╔═══╝ ██╔══██║██║     ██╔══██║
██║     ██║  ██║╚██████╗██║  ██║
╚═╝     ╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝</pre>
  <p class="sub">PERFORMING ARTISTS COLLECTIVE ALLIANCE // BOARD &amp; STAFF TERMINAL</p>

  <div id="login">
    <p>RESTRICTED SYSTEM. AUTHORIZED PERSONNEL ONLY.</p>
    <div class="row">
      <span>ACCESS CODE:</span>
      <input id="code" type="password" autocomplete="off" autofocus>
      <button id="enter">ENTER</button>
      <span class="blink">&#9608;</span>
    </div>
    <p id="loginErr" class="err hidden">ACCESS DENIED. TRY AGAIN.</p>
  </div>

  <div id="app" class="hidden">
    <div class="row" style="justify-content:space-between">
      <span class="muted">CONNECTED // WELCOME, BOARD MEMBER</span>
      <button id="logout" class="ghost">LOG OFF</button>
    </div>
    <hr>
    <h2 class="sec">// CALENDAR</h2>
    <div id="calWrap"></div>
    <hr>
    <div id="crumbs" class="crumbs"></div>
    <div id="view"></div>
  </div>
</div>

<script>
  // ===== board Google Calendar (already wired) =====
  var CONFIG = {
    calEmbed: "https://calendar.google.com/calendar/embed?src=89b14aa8a9197cacb2eaacbfc9a3e781af2979e8af95598d63e8a0efe4c7a0bb%40group.calendar.google.com&ctz=America%2FNew_York",
    calLink:  "https://calendar.google.com/calendar/embed?src=89b14aa8a9197cacb2eaacbfc9a3e781af2979e8af95598d63e8a0efe4c7a0bb%40group.calendar.google.com&ctz=America%2FNew_York"
  };

  var API = "/.netlify/functions/board";
  var $ = function(id){ return document.getElementById(id); };
  var KEY = sessionStorage.getItem("boardKey") || "";
  var state = { view:"boards", boardId:null, boardName:"", threadId:null, threadTitle:"" };

  function show(el){ el.classList.remove("hidden"); }
  function hide(el){ el.classList.add("hidden"); }
  function handle(){ return localStorage.getItem("boardHandle") || ""; }
  function fmt(ts){ try{ return new Date(ts).toLocaleString(); }catch(e){ return ts; } }
  function el(tag, attrs, kids){
    var n = document.createElement(tag);
    if(attrs) for(var k in attrs){ if(k==="text") n.textContent=attrs[k]; else if(k==="class") n.className=attrs[k]; else n.setAttribute(k,attrs[k]); }
    (kids||[]).forEach(function(c){ if(c) n.appendChild(c); });
    return n;
  }

  function api(action, opts){
    opts = opts || {};
    var qs = "action=" + encodeURIComponent(action);
    if(opts.params) for(var k in opts.params){ qs += "&" + encodeURIComponent(k) + "=" + encodeURIComponent(opts.params[k]); }
    return fetch(API + "?" + qs, {
      method: opts.method || "GET",
      headers: { "x-board-key": KEY, "content-type": "application/json" },
      body: opts.body ? JSON.stringify(opts.body) : undefined
    }).then(function(res){
      if(res.status === 401){ throw { auth:true }; }
      return res.json().then(function(d){ return { status:res.status, data:d }; });
    });
  }

  // ---------- CALENDAR ----------
  function renderCal(){
    var w = $("calWrap"); w.textContent = "";
    if(CONFIG.calEmbed){ var f = el("iframe",{src:CONFIG.calEmbed,title:"Board Calendar",loading:"lazy"}); w.appendChild(f); }
    if(CONFIG.calLink){ var a = el("a",{href:CONFIG.calLink,target:"_blank",rel:"noopener",text:"Open full calendar \u2192"}); a.style.display="inline-block"; a.style.marginTop="8px"; w.appendChild(a); }
  }

  // ---------- NAV ----------
  function crumbs(){
    var c = $("crumbs"); c.textContent = "";
    var boards = el("a",{text:"SECTIONS"}); boards.onclick = goBoards;
    c.appendChild(boards);
    if(state.view !== "boards"){
      c.appendChild(document.createTextNode("  /  "));
      if(state.view === "threads"){ c.appendChild(el("span",{text:state.boardName})); }
      else {
        var bl = el("a",{text:state.boardName}); bl.onclick = function(){ goThreads(state.boardId, state.boardName); };
        c.appendChild(bl);
        c.appendChild(document.createTextNode("  /  "));
        c.appendChild(el("span",{text:state.threadTitle}));
      }
    }
  }

  function goBoards(){
    state.view="boards";
    api("boards").then(function(r){ renderBoards(r.data.boards||[]); }).catch(authFail);
  }
  function goThreads(boardId, boardName){
    state.view="threads"; state.boardId=boardId; state.boardName=boardName;
    api("threads",{params:{boardId:boardId}}).then(function(r){ renderThreads(r.data.threads||[]); }).catch(authFail);
  }
  function goThread(id, title){
    state.view="thread"; state.threadId=id; state.threadTitle=title;
    api("thread",{params:{id:id}}).then(function(r){ if(r.status===200) renderThread(r.data.thread); }).catch(authFail);
  }
  function authFail(e){
    if(e && e.auth){ KEY=""; sessionStorage.removeItem("boardKey"); hide($("app")); show($("login")); $("code").value=""; }
  }

  // ---------- VIEWS ----------
  function renderBoards(boards){
    crumbs();
    var v = $("view"); v.textContent="";
    v.appendChild(el("div",{class:"toolbar"},[ el("h2",{class:"sec",text:"// SECTIONS"}), mkRefresh(goBoards) ]));

    var nameI = el("input",{placeholder:"NEW SECTION NAME (e.g. Event Planning)",maxlength:"60"});
    var addB = el("button",{text:"+ Create Section"});
    var errP = el("p",{class:"err hidden"});
    addB.onclick = function(){
      var name = nameI.value.trim(); hide(errP);
      if(!name){ errP.textContent="Enter a section name."; show(errP); return; }
      api("createBoard",{method:"POST",body:{name:name}}).then(function(r){ nameI.value=""; renderBoards(r.data.boards||[]); }).catch(authFail);
    };
    v.appendChild(el("div",{class:"newbox"},[nameI, el("div",{class:"row",style:"justify-content:flex-end"},[addB]), errP]));

    if(!boards.length){ v.appendChild(el("p",{class:"muted",text:"No sections yet. Create one above to get started."})); return; }
    boards.forEach(function(b){
      var open = el("div",{class:"open"},[ el("div",{class:"t",text:b.name}) ]);
      open.onclick = function(){ goThreads(b.id, b.name); };
      var del = el("button",{class:"xbtn",text:"DEL"});
      del.onclick = function(){ if(confirm('Delete section "'+b.name+'" and all its topics?')){ api("deleteBoard",{method:"POST",body:{id:b.id}}).then(function(r){ renderBoards(r.data.boards||[]); }).catch(authFail); } };
      v.appendChild(el("div",{class:"item"},[open, del]));
    });
  }

  function renderThreads(threads){
    crumbs();
    var v = $("view"); v.textContent="";
    v.appendChild(el("div",{class:"toolbar"},[ el("h2",{class:"sec",text:"// "+state.boardName.toUpperCase()}), mkRefresh(function(){ goThreads(state.boardId, state.boardName); }) ]));

    var titleI = el("input",{placeholder:"TOPIC TITLE",maxlength:"120"});
    var nameI  = el("input",{placeholder:"YOUR NAME / HANDLE",maxlength:"40",value:handle()});
    var msgI   = el("textarea",{placeholder:"Start the discussion...",maxlength:"4000"});
    var addB   = el("button",{text:"+ Post Topic"});
    var errP   = el("p",{class:"err hidden"});
    addB.onclick = function(){
      var title=titleI.value.trim(), name=nameI.value.trim(), message=msgI.value.trim(); hide(errP);
      if(!title || !message){ errP.textContent="Topic needs a title and a first message."; show(errP); return; }
      if(name) localStorage.setItem("boardHandle",name);
      api("createThread",{method:"POST",body:{boardId:state.boardId,title:title,name:name,message:message}}).then(function(r){
        if(r.status===200){ goThread(r.data.id, title); } else { errP.textContent="Error: "+(r.data.error||r.status); show(errP); }
      }).catch(authFail);
    };
    v.appendChild(el("div",{class:"newbox"},[titleI,nameI,msgI, el("div",{class:"row",style:"justify-content:flex-end"},[addB]), errP]));

    if(!threads.length){ v.appendChild(el("p",{class:"muted",text:"No topics in this section yet. Start one above."})); return; }
    threads.forEach(function(t){
      var open = el("div",{class:"open"},[
        el("div",{class:"t",text:t.title}),
        el("div",{class:"m",text:"by "+t.author+"  ·  "+(t.replyCount||0)+" repl"+((t.replyCount===1)?"y":"ies")+"  ·  last: "+fmt(t.lastTs||t.ts)})
      ]);
      open.onclick = function(){ goThread(t.id, t.title); };
      v.appendChild(el("div",{class:"item"},[open]));
    });
  }

  function renderThread(thread){
    crumbs();
    var v = $("view"); v.textContent="";
    v.appendChild(el("div",{class:"toolbar"},[ el("h2",{class:"sec",text:"// "+thread.title.toUpperCase()}), mkRefresh(function(){ goThread(thread.id, thread.title); }) ]));

    var posts = el("div",{});
    (thread.posts||[]).forEach(function(p){
      posts.appendChild(el("div",{class:"post"},[
        el("div",{class:"meta",text:">> "+p.name+"  ["+fmt(p.ts)+"]"}),
        el("div",{class:"body",text:p.message})
      ]));
    });
    v.appendChild(posts);
    v.appendChild(el("hr"));

    var nameI = el("input",{placeholder:"YOUR NAME / HANDLE",maxlength:"40",value:handle()});
    var msgI  = el("textarea",{placeholder:"Write a reply...",maxlength:"4000"});
    var addB  = el("button",{text:"Post Reply"});
    var errP  = el("p",{class:"err hidden"});
    addB.onclick = function(){
      var name=nameI.value.trim(), message=msgI.value.trim(); hide(errP);
      if(!message){ errP.textContent="Reply is empty."; show(errP); return; }
      if(name) localStorage.setItem("boardHandle",name);
      api("reply",{method:"POST",body:{id:thread.id,name:name,message:message}}).then(function(r){
        if(r.status===200){ renderThread(r.data.thread); } else { errP.textContent="Error: "+(r.data.error||r.status); show(errP); }
      }).catch(authFail);
    };
    v.appendChild(el("div",{class:"newbox"},[nameI,msgI, el("div",{class:"row",style:"justify-content:flex-end"},[addB]), errP]));
  }

  function mkRefresh(fn){ var b = el("button",{class:"ghost",text:"\u21bb Refresh"}); b.onclick = fn; return b; }

  // ---------- AUTH ----------
  function unlock(code){
    if(!code) return;
    KEY = code;
    api("boards").then(function(r){
      sessionStorage.setItem("boardKey", KEY);
      hide($("login")); show($("app"));
      renderCal(); renderBoards(r.data.boards||[]);
    }).catch(function(e){
      KEY=""; sessionStorage.removeItem("boardKey"); show($("loginErr"));
    });
  }

  $("enter").addEventListener("click", function(){ unlock($("code").value.trim()); });
  $("code").addEventListener("keydown", function(e){ if(e.key==="Enter") unlock($("code").value.trim()); });
  $("logout").addEventListener("click", function(){ KEY=""; sessionStorage.removeItem("boardKey"); hide($("app")); show($("login")); $("code").value=""; hide($("loginErr")); });

  if(KEY){ unlock(KEY); }
</script>
</body>
</html>{% endraw %}
