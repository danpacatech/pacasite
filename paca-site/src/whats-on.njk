---
layout: base.njk
title: What's On
description: Upcoming theatre, music, visual art, prose and dance at PACA in downtown Erie.
---
{% set upcoming = collections.shows | notPast %}

<section class="page-head">
  <div class="wrap">
    <div class="eyebrow label">The calendar</div>
    <h1>What's <em>on</em></h1>
    <p>Everything coming up at 1505 State Street. Grab tickets early, our black box is small on purpose.</p>
  </div>
</section>

<section class="block">
  <div class="wrap">
    {% if upcoming.length %}
    <div class="shows">
      {% for show in upcoming %}
      <div class="show rv">
        <div class="art" style="{% if show.data.image %}--art-img:url('{{ show.data.image }}'){% else %}background:linear-gradient(150deg,var(--ink-3),{{ show.data.discipline | disccolor }}){% endif %}"><span class="tag">{{ show.data.discipline }}</span></div>
        <div class="body">
          <div class="date">{{ show.data.date_label or (show.data.date_start | dateDisp) }}{% if show.data.showtime %} · {{ show.data.showtime }}{% endif %}</div>
          <h4>{{ show.data.title }}</h4>
          <p>{{ show.data.summary }}</p>
          <a class="ln" href="{{ show.url }}">Details →</a>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p style="color:var(--fog);font-size:1.1rem">No shows are posted yet. Check back soon.</p>
    {% endif %}
  </div>
</section>

{% if collections.pastByYear.length %}
<section class="block" style="border-top:1px solid var(--line)">
  <div class="wrap">
    <div class="sec-head rv"><h2>Past productions</h2></div>
    {% for grp in collections.pastByYear %}
    <h3 class="pastyr rv">{{ grp.year }}</h3>
    <div class="shows">
      {% for item in grp.items %}
      <div class="show rv">
        <div class="art" style="{% if item.image %}--art-img:url('{{ item.image }}'){% else %}background:linear-gradient(150deg,var(--ink-3),{{ item.discipline | disccolor }}){% endif %}"><span class="tag">{{ item.discipline }}</span></div>
        <div class="body">
          <div class="date">{{ grp.year }}</div>
          <h4>{{ item.title }}</h4>
          {% if item.blurb %}<p>{{ item.blurb }}</p>{% endif %}
          {% if item.url %}<a class="ln" href="{{ item.url }}">Details →</a>{% endif %}
          {% if item.playbill %}<a class="ln" href="{{ item.playbill }}" target="_blank" rel="noopener">Playbill (PDF) →</a>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
