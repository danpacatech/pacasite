---
permalink: "/volunteer-events.json"
eleventyExcludeFromCollections: true
---
[{% for ev in collections.volunteer_events %}{% set d = ev.data %}{% set dateStr = d.date | date("yyyy-MM-dd") %}{"id":{{ ev.fileSlug | dump | safe }},"name":{{ (d.name or ev.fileSlug) | dump | safe }},"date":{{ dateStr | dump | safe }},"time":{{ (d.time or "") | dump | safe }},"active":{{ (d.active if d.active != undefined else true) | dump | safe }},"slots":[{% for slot in (d.slots or []) %}{"id":{{ (ev.fileSlug + "-" + loop.index0 | string) | dump | safe }},"role":{{ (slot.role or "") | dump | safe }},"capacity":{{ (slot.capacity or 1) }}}{% if not loop.last %},{% endif %}{% endfor %}]}{% if not loop.last %},{% endif %}{% endfor %}]
